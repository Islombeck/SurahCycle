<?xml version="1.0" encoding="utf-8"?>
<!--
    `updatePeriodMillis` is 30 minutes here and zero for the other two
    widgets, and the difference is the point.

    Rotation and Learning change when the owner does something, and the app
    pushes them a new snapshot when he does. This one changes because time
    passed: the snapshot carries the day's windows, the widget compares them
    against its own clock, and nothing wakes it to do the comparing again.
    Left at zero it redrew only when the launcher happened to rebuild it,
    which is how it came to sit on Asr for days.

    Thirty minutes is Android's floor for this; shorter values are silently
    clamped. Since the horizontal strip it is only the backstop: each update
    also books an inexact, non-waking alarm at the end of the current window
    (PrayerWidgetRefresh), which needs no permission and lands within ten
    minutes after the boundary. The strip's countdown is what made half an
    hour matter.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/prayer_widget_description"
    android:initialLayout="@layout/widget_loading"
    android:minHeight="100dp"
    android:minResizeHeight="100dp"
    android:minResizeWidth="150dp"
    android:minWidth="150dp"
    android:previewLayout="@layout/prayer_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
