  "fixed_sql": [
    {
      "name": "surah_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"surah_metadata\" (\"id\" TEXT NOT NULL, \"surah_number\" INTEGER NOT NULL UNIQUE, \"official_name\" TEXT NOT NULL, \"ayah_count\" INTEGER NOT NULL, \"source_id\" TEXT NULL, \"source_version\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (surah_number > 0), CHECK (ayah_count > 0), CHECK (length(official_name) > 0));"
        }
      ]
    },
    {
      "name": "mastered_surahs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mastered_surahs\" (\"surah_id\" TEXT NOT NULL REFERENCES surah_metadata (id) ON DELETE RESTRICT, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)), \"has_entered_rotation\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_entered_rotation\" IN (0, 1)), \"activation_baseline_score\" INTEGER NULL, \"cached_rotation_score\" INTEGER NOT NULL DEFAULT 0, \"cached_total_recitations\" INTEGER NOT NULL DEFAULT 0, \"cached_last_used_at_utc\" INTEGER NULL, \"alias\" TEXT NULL, \"display_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"surah_id\"), CHECK (activation_baseline_score IS NULL OR activation_baseline_score >= 0), CHECK (cached_rotation_score >= 0), CHECK (cached_total_recitations >= 0), CHECK (has_entered_rotation = 1 OR is_active = 0));"
        }
      ]
    },
    {
      "name": "rotation_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rotation_states\" (\"singleton_id\" INTEGER NOT NULL DEFAULT 1, \"rotation_target\" INTEGER NOT NULL DEFAULT 1, \"last_journal_sequence\" INTEGER NOT NULL DEFAULT 0, \"projection_version\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"singleton_id\"), CHECK (singleton_id = 1), CHECK (rotation_target >= 1), CHECK (last_journal_sequence >= 0), CHECK (projection_version > 0));"
        }
      ]
    },
    {
      "name": "rotation_schemes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rotation_schemes\" (\"id\" TEXT NOT NULL, \"surah_id\" TEXT NOT NULL REFERENCES mastered_surahs (surah_id) ON DELETE RESTRICT, \"version\" INTEGER NOT NULL, \"ayah_count_snapshot\" INTEGER NOT NULL, \"baseline_score\" INTEGER NOT NULL, \"baseline_total_recitations\" INTEGER NOT NULL, \"baseline_last_used_at_utc\" INTEGER NULL, \"activated_journal_sequence\" INTEGER NOT NULL, \"superseded_journal_sequence\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"surah_id\", \"version\"), UNIQUE (\"id\", \"surah_id\"), CHECK (length(id) > 0), CHECK (version > 0), CHECK (ayah_count_snapshot > 0), CHECK (baseline_score >= 0), CHECK (baseline_total_recitations >= 0), CHECK (activated_journal_sequence >= 0), CHECK (superseded_journal_sequence IS NULL OR superseded_journal_sequence >= activated_journal_sequence));"
        }
      ]
    },
    {
      "name": "rotation_parts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rotation_parts\" (\"id\" TEXT NOT NULL, \"scheme_id\" TEXT NOT NULL REFERENCES rotation_schemes (id) ON DELETE CASCADE, \"ordinal\" INTEGER NOT NULL, \"start_ayah\" INTEGER NOT NULL, \"end_ayah\" INTEGER NOT NULL, \"cached_score\" INTEGER NOT NULL, \"cached_recitation_count\" INTEGER NOT NULL, \"cached_last_used_at_utc\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"scheme_id\", \"ordinal\"), UNIQUE (\"id\", \"scheme_id\"), CHECK (length(id) > 0), CHECK (ordinal BETWEEN 1 AND 4), CHECK (start_ayah > 0), CHECK (end_ayah >= start_ayah), CHECK (cached_score >= 0), CHECK (cached_recitation_count >= 0));"
        }
      ]
    },
    {
      "name": "prayer_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"prayer_sessions\" (\"id\" TEXT NOT NULL, \"prayer_type\" TEXT NOT NULL, \"is_qada\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_qada\" IN (0, 1)), \"started_at_utc\" INTEGER NOT NULL, \"local_date\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (prayer_type IN ('fajr', 'dhuhr', 'asr', 'maghrib', 'isha', 'witr', 'nafl')), CHECK (is_qada = 0 OR prayer_type != 'nafl'));"
        }
      ]
    },
    {
      "name": "recitation_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recitation_events\" (\"id\" TEXT NOT NULL, \"journal_sequence\" INTEGER NOT NULL UNIQUE, \"surah_id\" TEXT NOT NULL REFERENCES mastered_surahs (surah_id) ON DELETE RESTRICT, \"rotation_scheme_id\" TEXT NOT NULL, \"rakaat_span_count\" INTEGER NOT NULL, \"prayer_session_id\" TEXT NULL REFERENCES prayer_sessions (id) ON DELETE SET NULL, \"created_at_utc\" INTEGER NOT NULL, \"local_date\" TEXT NOT NULL, \"prayer_type\" TEXT NOT NULL, \"is_qada\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_qada\" IN (0, 1)), \"deleted_at_utc\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"id\", \"rotation_scheme_id\"), CHECK (length(id) > 0), CHECK (journal_sequence > 0), CHECK (prayer_type IN ('fajr', 'dhuhr', 'asr', 'maghrib', 'isha', 'witr', 'nafl')), CHECK (is_qada = 0 OR prayer_type != 'nafl'), CHECK (rakaat_span_count >= 1), FOREIGN KEY (rotation_scheme_id, surah_id) REFERENCES rotation_schemes (id, surah_id) ON DELETE RESTRICT);"
        }
      ]
    },
    {
      "name": "recitation_event_parts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recitation_event_parts\" (\"event_id\" TEXT NOT NULL, \"scheme_id\" TEXT NOT NULL, \"part_id\" TEXT NOT NULL, PRIMARY KEY (\"event_id\", \"part_id\"), FOREIGN KEY (event_id, scheme_id) REFERENCES recitation_events (id, rotation_scheme_id) ON DELETE CASCADE, FOREIGN KEY (part_id, scheme_id) REFERENCES rotation_parts (id, scheme_id) ON DELETE RESTRICT);"
        }
      ]
    },
    {
      "name": "rotation_adjustments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rotation_adjustments\" (\"id\" TEXT NOT NULL, \"journal_sequence\" INTEGER NOT NULL UNIQUE, \"surah_id\" TEXT NOT NULL REFERENCES mastered_surahs (surah_id) ON DELETE RESTRICT, \"rotation_scheme_id\" TEXT NOT NULL, \"delta\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"created_at_utc\" INTEGER NOT NULL, \"deleted_at_utc\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (length(id) > 0), CHECK (journal_sequence > 0), CHECK (delta != 0), CHECK (length(reason) > 0), FOREIGN KEY (rotation_scheme_id, surah_id) REFERENCES rotation_schemes (id, surah_id) ON DELETE RESTRICT);"
        }
      ]
    },
    {
      "name": "learning_surahs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"learning_surahs\" (\"id\" TEXT NOT NULL, \"surah_id\" TEXT NOT NULL UNIQUE REFERENCES surah_metadata (id) ON DELETE RESTRICT, \"ayah_count\" INTEGER NOT NULL, \"stage_kind\" TEXT NOT NULL, \"stage_end_ayah\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"last_learning_activity_at_utc\" INTEGER NULL, \"inactivity_rollback_for_activity_at_utc\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (ayah_count > 0), CHECK (stage_end_ayah > 0 AND stage_end_ayah <= ayah_count), CHECK (stage_kind IN ('newAyah', 'cumulative')), CHECK (status IN ('active', 'completed')));"
        }
      ]
    },
    {
      "name": "learning_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"learning_events\" (\"id\" TEXT NOT NULL, \"sequence\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"learning_surah_id\" TEXT NOT NULL REFERENCES learning_surahs (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"created_at_utc\" INTEGER NOT NULL, \"from_stage_kind\" TEXT NOT NULL, \"from_stage_end_ayah\" INTEGER NOT NULL, \"to_stage_kind\" TEXT NOT NULL, \"to_stage_end_ayah\" INTEGER NOT NULL, UNIQUE (\"id\"), CHECK (length(id) > 0), CHECK (type IN ('repeated', 'learned', 'inactivityRollback', 'completed')), CHECK (from_stage_kind IN ('newAyah', 'cumulative')), CHECK (to_stage_kind IN ('newAyah', 'cumulative')), CHECK (from_stage_end_ayah > 0), CHECK (to_stage_end_ayah > 0));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"value_type\" TEXT NOT NULL, \"updated_at_utc\" INTEGER NOT NULL, PRIMARY KEY (\"key\"), CHECK (value_type IN ('string', 'bool', 'int', 'double')));"
        }
      ]
    }
  ]
}